{
	"schemaVersion": 1,
	"id": "cardbound",
	"version": "${version}",
	"name": "Cardbound",
	"description": "Bring collectible cards and magical abilities to Minecraft! Discover booster packs, collect unique cards, and harness their powers using Essence. Build your collection, experiment with different abilities, and bring a little magic to every adventure.",
	"authors": [
		"Siskin"
	],
	"contributors": [
		"bubblepixel"
	],
	"contact": {
		"homepage": "https://modrinth.com/project/cardbound",
		"sources": "https://github.com/luuknijkmp/Cardbound",
		"issues": "https://github.com/luuknijkmp/Cardbound/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/cardbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cardbound.Cardbound"
		],
		"client": [
			"cardbound.client.CardboundClient"
		],
		"modmenu": [
			"cardbound.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"cardbound.mixins.json",
		{
			"config": "cardbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}