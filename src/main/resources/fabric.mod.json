{
	"schemaVersion": 1,
	"id": "cardbound",
	"version": "${version}",
	"name": "Cardbound",
	"description": "Discover powerful cards and unleash their abilities throughout your Minecraft world.",
	"authors": [
		"Siskin"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/cardbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"cardbound.Cardbound"
		],
		"client": [
			"cardbound.client.CardboundClient"
		],
		"modmenu": [
			"cardbound.client.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		"cardbound.mixins.json",
		{
			"config": "cardbound.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}